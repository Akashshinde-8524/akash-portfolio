# ==============================================================================
# Portfolio Admin & Cloud Storage Configuration
# ==============================================================================

# Master Secret Key for private /admin access
# Change this to any secret password/passphrase you like
VITE_ADMIN_SECRET_KEY=your_secret_admin_key_here

# Upstash Redis REST API (100% Free Serverless Cloud Store)
# 1. Create a free Redis database at https://console.upstash.com
# 2. Scroll to the "REST API" section and copy the URL and token below
VITE_UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
VITE_UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
